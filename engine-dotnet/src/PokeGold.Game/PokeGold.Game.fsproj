<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PokeGold.Game</RootNamespace>
    <AssemblyName>PokeGold.Game</AssemblyName>
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core: framebuffer, assets, palettes, tiles, primitives, input. -->
    <Compile Include="Core\Display.fs" />
    <Compile Include="Core\Assets.fs" />
    <Compile Include="Core\Palette.fs" />
    <Compile Include="Core\Tile.fs" />
    <Compile Include="Core\Image.fs" />
    <Compile Include="Core\Graphics.fs" />
    <Compile Include="Core\Direction.fs" />
    <Compile Include="Core\Buttons.fs" />
    <!-- Data: typed game data loaded from the disassembly + an asset cache. -->
    <Compile Include="Data\Tileset.fs" />
    <Compile Include="Data\Map.fs" />
    <Compile Include="Data\Collision.fs" />
    <Compile Include="Data\Sprite.fs" />
    <Compile Include="Data\Content.fs" />
    <!-- Overworld: immutable state + pure systems (movement, camera, anim). -->
    <Compile Include="Overworld\Player.fs" />
    <Compile Include="Overworld\Movement.fs" />
    <Compile Include="Overworld\Camera.fs" />
    <Compile Include="Overworld\Animation.fs" />
    <Compile Include="Overworld\OverworldState.fs" />
    <!-- Render: draw typed state into the framebuffer. -->
    <Compile Include="Render\MapRenderer.fs" />
    <Compile Include="Render\SpriteRenderer.fs" />
    <Compile Include="Render\OverworldRenderer.fs" />
    <!-- Scenes: the scene-stack abstraction and the overworld scene. -->
    <Compile Include="Scenes\Scene.fs" />
    <Compile Include="Scenes\OverworldScene.fs" />
    <!-- Top-level game: asset cache + scene stack. -->
    <Compile Include="Game.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

</Project>
