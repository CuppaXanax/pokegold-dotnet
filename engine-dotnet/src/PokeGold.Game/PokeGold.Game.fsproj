<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PokeGold.Game</RootNamespace>
    <AssemblyName>PokeGold.Game</AssemblyName>
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core: framebuffer, assets, palettes, tiles, primitives, input. -->
    <Compile Include="Core\Display.fs" />
    <Compile Include="Core\Assets.fs" />
    <Compile Include="Core\Palette.fs" />
    <Compile Include="Core\Tile.fs" />
    <Compile Include="Core\Image.fs" />
    <Compile Include="Core\Graphics.fs" />
    <Compile Include="Core\Direction.fs" />
    <Compile Include="Core\Buttons.fs" />
    <Compile Include="Core\Charmap.fs" />
    <!-- Data: typed game data + an asset cache. Tabular game data (species,
         moves, type chart) is generated at build time by PokeGold.DataGen into
         Data\Generated\ and baked into this assembly; see the GenerateGameData
         target below. -->
    <Compile Include="Data\Tileset.fs" />
    <Compile Include="Data\Map.fs" />
    <Compile Include="Data\Collision.fs" />
    <Compile Include="Data\Sprite.fs" />
    <Compile Include="Data\Font.fs" />
    <Compile Include="Data\Schema.fs" />
    <Compile Include="Data\Generated\TypeChart.Generated.fs" />
    <Compile Include="Data\Generated\Species.Generated.fs" />
    <Compile Include="Data\Generated\Moves.Generated.fs" />
    <Compile Include="Data\TypeChart.fs" />
    <Compile Include="Data\Species.fs" />
    <Compile Include="Data\Moves.fs" />
    <Compile Include="Data\Content.fs" />
    <!-- Overworld: immutable state + pure systems (movement, camera, anim). -->
    <Compile Include="Overworld\Player.fs" />
    <Compile Include="Overworld\Movement.fs" />
    <Compile Include="Overworld\Camera.fs" />
    <Compile Include="Overworld\Animation.fs" />
    <Compile Include="Overworld\OverworldState.fs" />
    <!-- Save: versioned JSON save model + on-disk persistence. -->
    <Compile Include="Save\SaveData.fs" />
    <Compile Include="Save\SaveFile.fs" />
    <!-- Audio: parse the GSC sound script, sequence + software-synth the 4 GB
         channels to PCM (pure, no MonoGame; the host owns the sound device). -->
    <Compile Include="Audio\AudioData.fs" />
    <Compile Include="Audio\SoundCommand.fs" />
    <Compile Include="Audio\SongParser.fs" />
    <Compile Include="Audio\Synth.fs" />
    <Compile Include="Audio\AudioEngine.fs" />
    <!-- Text:charmap-encoded streams + the typewriter box state machine. -->
    <Compile Include="Text\TextStream.fs" />
    <Compile Include="Text\TextBox.fs" />
    <!-- Battle: immutable battlers + Gen-2 damage, effect commands, turn loop. -->
    <Compile Include="Battle\BattleMon.fs" />
    <Compile Include="Battle\Damage.fs" />
    <Compile Include="Battle\Effects.fs" />
    <Compile Include="Battle\Battle.fs" />
    <!-- Render: draw typed state into the framebuffer. -->
    <Compile Include="Render\MapRenderer.fs" />
    <Compile Include="Render\SpriteRenderer.fs" />
    <Compile Include="Render\OverworldRenderer.fs" />
    <Compile Include="Render\TextRenderer.fs" />
    <Compile Include="Render\BattleRenderer.fs" />
    <!-- Scenes: the scene-stack abstraction and the overworld scene. -->
    <Compile Include="Scenes\Scene.fs" />
    <Compile Include="Scenes\TextBoxScene.fs" />
    <Compile Include="Scenes\BattleScene.fs" />
    <Compile Include="Scenes\OverworldScene.fs" />
    <!-- Top-level game: asset cache + scene stack. -->
    <Compile Include="Game.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <!-- Build-order only: ensure the generator is compiled before we run it. Its
       assembly is never referenced at runtime (ReferenceOutputAssembly=false). -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\PokeGold.DataGen\PokeGold.DataGen.fsproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The disassembly tables that feed code generation (target Inputs) and the
       generated F# sources they produce (target Outputs). $(RepoRoot) resolves
       to the repository root three levels above this project. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <GeneratedDataDir>$(MSBuildThisFileDirectory)Data\Generated</GeneratedDataDir>
  </PropertyGroup>

  <ItemGroup>
    <GameDataInput Include="$(RepoRoot)constants\type_constants.asm" />
    <GameDataInput Include="$(RepoRoot)constants\pokemon_constants.asm" />
    <GameDataInput Include="$(RepoRoot)data\types\type_matchups.asm" />
    <GameDataInput Include="$(RepoRoot)data\moves\moves.asm" />
    <GameDataInput Include="$(RepoRoot)data\pokemon\base_stats\*.asm" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\TypeChart.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Species.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Moves.Generated.fs" />
  </ItemGroup>

  <!-- Regenerate the baked data tables whenever a source table changes (or the
       generated files are missing). Runs before the F# compile so the generated
       sources are present for CoreCompile. Incremental via Inputs/Outputs. -->
  <Target Name="GenerateGameData"
          BeforeTargets="CoreCompile"
          Inputs="@(GameDataInput)"
          Outputs="@(GeneratedDataOutput)">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\tools\PokeGold.DataGen\PokeGold.DataGen.fsproj&quot; -c $(Configuration) -- &quot;$(GeneratedDataDir)&quot;" />
  </Target>

</Project>
