<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PokeGold.Game</RootNamespace>
    <AssemblyName>PokeGold.Game</AssemblyName>
    <OtherFlags>$(OtherFlags) --nowarn:57</OtherFlags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core: framebuffer, assets, palettes, tiles, primitives, input. -->
    <Compile Include="Core\Display.fs" />
    <Compile Include="Core\Png.fs" />
    <Compile Include="Core\Assets.fs" />
    <Compile Include="Core\Palette.fs" />
    <Compile Include="Core\Tile.fs" />
    <Compile Include="Core\Image.fs" />
    <Compile Include="Core\Graphics.fs" />
    <Compile Include="Core\Direction.fs" />
    <Compile Include="Core\Buttons.fs" />
    <Compile Include="Core\Charmap.fs" />
    <Compile Include="Core\TimeOfDay.fs" />
    <!-- Ui: pure state machines and geometry helpers (menus, HP bar, windowing). -->
    <Compile Include="Ui\MenuInput.fs" />
    <Compile Include="Ui\MenuList.fs" />
    <Compile Include="Ui\HpBar.fs" />
    <Compile Include="Ui\Window.fs" />
    <!-- Data: typed game data + an asset cache. Tabular game data (species,
         moves, type chart) is generated at build time by PokeGold.DataGen into
         Data\Generated\ and baked into this assembly; see the GenerateGameData
         target below. -->
    <Compile Include="Data\Tileset.fs" />
    <Compile Include="Data\Map.fs" />
    <Compile Include="Data\Collision.fs" />
    <Compile Include="Data\Sprite.fs" />
    <Compile Include="Data\Font.fs" />
    <Compile Include="Data\Schema.fs" />
    <Compile Include="Data\Generated\TypeChart.Generated.fs" />
    <Compile Include="Data\Generated\Species.Generated.fs" />
    <Compile Include="Data\Generated\Moves.Generated.fs" />
    <Compile Include="Data\Generated\EvosAttacks.Generated.fs" />
    <Compile Include="Data\Generated\SpriteMovement.Generated.fs" />
    <Compile Include="Data\Generated\Maps.Generated.fs" />
    <Compile Include="Data\Generated\StdScripts.Generated.fs" />
    <Compile Include="Data\Generated\Music.Generated.fs" />
    <Compile Include="Data\Generated\Songs.Generated.fs" />
    <Compile Include="Data\Generated\Items.Generated.fs" />
    <Compile Include="Data\Generated\Marts.Generated.fs" />
    <Compile Include="Data\Generated\Trainers.Generated.fs" />
    <Compile Include="Data\Generated\WildEncounters.Generated.fs" />
    <Compile Include="Data\Generated\Dex.Generated.fs" />
    <Compile Include="Data\TypeChart.fs" />
    <Compile Include="Data\Species.fs" />
    <Compile Include="Data\Moves.fs" />
    <Compile Include="Data\EvosAttacks.fs" />
    <Compile Include="Data\Content.fs" />
    <Compile Include="Data\Items.fs" />
    <Compile Include="Data\Trainers.fs" />
    <Compile Include="Data\WildEncounters.fs" />
    <Compile Include="Data\Dex.fs" />
    <!-- Overworld: immutable state + pure systems (movement, camera, anim). -->
    <Compile Include="Overworld\Player.fs" />
    <Compile Include="Overworld\Movement.fs" />
    <Compile Include="Overworld\MapConnections.fs" />
    <Compile Include="Overworld\Camera.fs" />
    <Compile Include="Overworld\Animation.fs" />
    <!-- Overworld scripts: the flag/var/scene world store, the resumable script
         VM, the map event-table queries, and triggers. The event-script command
         DUs, the .asm parsers, and the map metadata types live in the shared
         PokeGold.MapData project (also used by the build-time generator); the
         files here are the runtime-only pieces that depend on World/Assets. -->
    <Compile Include="Overworld\Script\EventFlags.fs" />
    <Compile Include="Overworld\Script\Script.fs" />
    <Compile Include="Overworld\Script\MapEvents.fs" />
    <Compile Include="Overworld\Script\Triggers.fs" />
    <Compile Include="Overworld\Script\AsmLoad.fs" />
    <Compile Include="Overworld\Object.fs" />
    <Compile Include="Overworld\ObjectStep.fs" />
    <Compile Include="Overworld\MovementRunner.fs" />
    <Compile Include="Overworld\OverworldState.fs" />
    <!-- Audio: parse the GSC sound script, sequence + software-synth the 4 GB
         channels to PCM (pure, no MonoGame; the host owns the sound device). -->
    <Compile Include="Audio\AudioData.fs" />
    <Compile Include="Audio\SongParser.fs" />
    <Compile Include="Audio\Apu.fs" />
    <Compile Include="Audio\ApuChip.fs" />
    <Compile Include="Audio\Synth.fs" />
    <Compile Include="Audio\AudioEngine.fs" />
    <!-- Text:charmap-encoded streams + the typewriter box state machine. -->
    <Compile Include="Text\TextStream.fs" />
    <Compile Include="Text\TextBox.fs" />
    <!-- Battle: immutable battlers + Gen-2 damage, effect commands, turn loop. -->
    <Compile Include="Battle\BattleMon.fs" />
    <Compile Include="Battle\Damage.fs" />
    <Compile Include="Battle\EffectCommand.fs" />
    <Compile Include="Battle\Effects.fs" />
    <Compile Include="Battle\BattleAI.fs" />
    <Compile Include="Battle\Battle.fs" />
    <Compile Include="Battle\Experience.fs" />
    <!-- Player: persistent party, bag, dex state. -->
    <Compile Include="Player\PartyMon.fs" />
    <Compile Include="Player\Evolution.fs" />
    <Compile Include="Player\MoveLearn.fs" />
    <Compile Include="Overworld\FieldMoves.fs" />
    <Compile Include="Player\Heal.fs" />
    <Compile Include="Player\Bag.fs" />
    <Compile Include="Player\Money.fs" />
    <Compile Include="Player\Mart.fs" />
    <Compile Include="Player\Storage.fs" />
    <Compile Include="Player\Player.fs" />
    <Compile Include="Overworld\WildEncounter.fs" />
    <Compile Include="Player\BoxOps.fs" />
    <Compile Include="Player\PcItemOps.fs" />
    <Compile Include="Player\DebugSeed.fs" />
    <!-- Save: versioned JSON save model + on-disk persistence. -->
    <Compile Include="Save\SaveData.fs" />
    <Compile Include="Save\SaveFile.fs" />
    <!-- Render: draw typed state into the framebuffer. -->
    <Compile Include="Render\MapRenderer.fs" />
    <Compile Include="Render\SpriteRenderer.fs" />
    <Compile Include="Render\OverworldRenderer.fs" />
    <Compile Include="Render\WindowRenderer.fs" />
    <Compile Include="Render\TextRenderer.fs" />
    <Compile Include="Render\BattleRenderer.fs" />
    <!-- Scenes: the scene-stack abstraction and the overworld scene. -->
    <Compile Include="Scenes\Scene.fs" />
    <Compile Include="Scenes\TextBoxScene.fs" />
    <Compile Include="Scenes\BattleScene.fs" />
    <Compile Include="Scenes\YesNoScene.fs" />
    <Compile Include="Scenes\StartMenuScene.fs" />
    <Compile Include="Scenes\PackUseGive.fs" />
    <Compile Include="Scenes\SummaryScene.fs" />
    <Compile Include="Scenes\PartyScene.fs" />
    <Compile Include="Scenes\PackScene.fs" />
    <Compile Include="Scenes\MartScene.fs" />
    <Compile Include="Scenes\PCBoxScene.fs" />
    <Compile Include="Scenes\PlayerPCScene.fs" />
    <Compile Include="Scenes\PcMenuScene.fs" />
    <Compile Include="Scenes\PokedexScene.fs" />
    <Compile Include="Scenes\PokegearScene.fs" />
    <Compile Include="Scenes\OptionsScene.fs" />
    <Compile Include="Scenes\SaveMenuScene.fs" />
    <Compile Include="Scenes\OverworldScene.fs" />
    <!-- Debug command pipe (T1): inspect/poke a running instance. -->
    <Compile Include="Debug\DebugChannel.fs" />
    <Compile Include="Debug\DebugServer.fs" />
    <Compile Include="Debug\DebugCommands.fs" />
    <!-- Top-level game: asset cache + scene stack. -->
    <Compile Include="Game.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <!-- Shared, runtime-referenced map DUs + .asm parsers (also used by the
       build-time generator). -->
  <ItemGroup>
    <ProjectReference Include="..\PokeGold.MapData\PokeGold.MapData.fsproj" />
  </ItemGroup>

  <!-- Build-order only: ensure the generator is compiled before we run it. Its
       assembly is never referenced at runtime (ReferenceOutputAssembly=false). -->
  <ItemGroup>
    <ProjectReference Include="..\..\tools\PokeGold.DataGen\PokeGold.DataGen.fsproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <!-- The disassembly tables that feed code generation (target Inputs) and the
       generated F# sources they produce (target Outputs). $(RepoRoot) resolves
       to the repository root three levels above this project. -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)..\..\..\</RepoRoot>
    <GeneratedDataDir>$(MSBuildThisFileDirectory)Data\Generated</GeneratedDataDir>
  </PropertyGroup>

  <ItemGroup>
    <GameDataInput Include="$(RepoRoot)constants\type_constants.asm" />
    <GameDataInput Include="$(RepoRoot)constants\pokemon_constants.asm" />
    <GameDataInput Include="$(RepoRoot)constants\map_constants.asm" />
    <GameDataInput Include="$(RepoRoot)constants\item_constants.asm" />
    <GameDataInput Include="$(RepoRoot)data\types\type_matchups.asm" />
    <GameDataInput Include="$(RepoRoot)data\moves\moves.asm" />
    <GameDataInput Include="$(RepoRoot)data\pokemon\base_stats\*.asm" />
    <GameDataInput Include="$(RepoRoot)data\pokemon\evos_attacks.asm" />
    <GameDataInput Include="$(RepoRoot)data\pokemon\names.asm" />
    <GameDataInput Include="$(RepoRoot)data\pokemon\dex_entries\gold\*.asm" />
    <GameDataInput Include="$(RepoRoot)data\items\attributes.asm" />
    <GameDataInput Include="$(RepoRoot)data\items\names.asm" />
    <GameDataInput Include="$(RepoRoot)data\items\descriptions.asm" />
    <GameDataInput Include="$(RepoRoot)data\items\marts.asm" />
    <GameDataInput Include="$(RepoRoot)constants\mart_constants.asm" />
    <GameDataInput Include="$(RepoRoot)data\wild\johto_grass.asm" />
    <GameDataInput Include="$(RepoRoot)data\wild\kanto_grass.asm" />
    <GameDataInput Include="$(RepoRoot)data\wild\johto_water.asm" />
    <GameDataInput Include="$(RepoRoot)data\wild\kanto_water.asm" />
    <GameDataInput Include="$(RepoRoot)data\trainers\parties.asm" />
    <GameDataInput Include="$(RepoRoot)data\trainers\attributes.asm" />
    <GameDataInput Include="$(RepoRoot)data\maps\maps.asm" />
    <GameDataInput Include="$(RepoRoot)data\sprites\map_objects.asm" />
    <GameDataInput Include="$(RepoRoot)data\maps\attributes.asm" />
    <GameDataInput Include="$(RepoRoot)data\maps\blocks.asm" />
    <GameDataInput Include="$(RepoRoot)maps\*.asm" />
    <GameDataInput Include="$(RepoRoot)constants\music_constants.asm" />
    <GameDataInput Include="$(RepoRoot)audio\music_pointers.asm" />
    <GameDataInput Include="$(RepoRoot)audio\music\*.asm" />
    <GameDataInput Include="$(RepoRoot)audio\sfx.asm" />
    <GameDataInput Include="$(RepoRoot)engine\events\std_scripts.asm" />
    <GameDataInput Include="$(RepoRoot)data\text\std_text.asm" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\TypeChart.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Species.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Moves.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\EvosAttacks.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\SpriteMovement.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Maps.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\StdScripts.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Music.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Songs.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Items.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Marts.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Trainers.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\WildEncounters.Generated.fs" />
    <GeneratedDataOutput Include="$(GeneratedDataDir)\Dex.Generated.fs" />
  </ItemGroup>

  <!-- Regenerate the baked data tables whenever a source table changes (or the
       generated files are missing). Runs before the F# compile so the generated
       sources are present for CoreCompile. Incremental via Inputs/Outputs. -->
  <Target Name="GenerateGameData"
          BeforeTargets="CoreCompile"
          Inputs="@(GameDataInput)"
          Outputs="@(GeneratedDataOutput)">
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)..\..\tools\PokeGold.DataGen\PokeGold.DataGen.fsproj&quot; -c $(Configuration) -- &quot;$(GeneratedDataDir)&quot;" />
  </Target>

</Project>
