<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PokeGold.DataGen</RootNamespace>
    <AssemblyName>PokeGold.DataGen</AssemblyName>
    <!-- Tooling only: never referenced at runtime by the game. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Repo.fs" />
    <Compile Include="AsmConstants.fs" />
    <Compile Include="Parsers.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

</Project>
