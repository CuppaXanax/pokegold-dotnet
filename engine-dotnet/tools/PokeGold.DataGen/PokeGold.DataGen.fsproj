<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>PokeGold.DataGen</RootNamespace>
    <AssemblyName>PokeGold.DataGen</AssemblyName>
    <!-- Tooling only: never referenced at runtime by the game. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Repo.fs" />
    <Compile Include="AsmConstants.fs" />
    <Compile Include="Parsers.fs" />
    <Compile Include="MapParsers.fs" />
    <Compile Include="MusicParsers.fs" />
    <Compile Include="EmitMaps.fs" />
    <Compile Include="EmitSongs.fs" />
    <Compile Include="Emit.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <!-- The shared map DUs + .asm parsers, so the generator bakes the same values
       the runtime consumes. Output assembly is not needed by the game build, but
       DataGen links it to call the parsers. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\PokeGold.MapData\PokeGold.MapData.fsproj" />
  </ItemGroup>

</Project>
